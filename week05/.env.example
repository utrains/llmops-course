# Copy this file to .env and paste your real keys.
# .env is git-ignored. Never commit secrets.

# Week 2 optional Claude cells, and Week 3 Lab 1 (required).
# Sign up at https://console.anthropic.com
# In production this same key lives in AWS Secrets Manager, Doppler, or HashiCorp Vault.
ANTHROPIC_API_KEY=

# Week 3 Lab 1 (required): OpenAI embeddings.
# Sign up at https://platform.openai.com
# Claude does not produce embeddings. US RAG stacks pair Claude with OpenAI, Voyage, or Cohere.
OPENAI_API_KEY=

# Lab 3 — real AWS tools (read-only IAM user recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
